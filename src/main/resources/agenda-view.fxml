<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="643.0" prefWidth="937.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.MainController">
    <children>
        <Label layoutX="439.0" layoutY="14.0" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Agenda CRUD" />

        <Label layoutX="41.0" layoutY="53.0" text="Buscar:" />
        <TextField fx:id="txtBuscar" layoutX="90.0" layoutY="49.0" prefWidth="250.0" promptText="Nombre, Dirección o Teléfono..." />

        <Button fx:id="btnNuevo" layoutX="780.0" layoutY="49.0" onAction="#abrirVentanaAgregar" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="+ Nueva Persona" />

        <TableView fx:id="tablaPersonas" layoutX="41.0" layoutY="91.0" prefHeight="450.0" prefWidth="852.0">
            <columns>
                <TableColumn fx:id="colID" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                <TableColumn fx:id="colDireccion" prefWidth="350.0" text="Direcciones" />
                <TableColumn fx:id="colTelefonos" prefWidth="200.0" text="Acciones" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" layoutX="41.0" layoutY="560.0" spacing="10.0">
            <children>
                <Label text="Vista Rápida:" style="-fx-font-weight: bold;" />
                <TextField fx:id="txtEditID" disable="true" editable="false" prefWidth="50.0" promptText="ID" />
                <TextField fx:id="txtEditNombre" editable="false" prefWidth="200.0" promptText="Nombre" />
                <TextField fx:id="txtEditDireccion" editable="false" prefWidth="250.0" promptText="Dirección Principal" />

                <Button onAction="#handleActualizar" style="-fx-background-color: #FFC107; -fx-text-fill: black;" text="✏ Editar" />
                <Button onAction="#handleEliminar" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="🗑 Eliminar" />
            </children>
        </HBox>

    </children>
</AnchorPane>