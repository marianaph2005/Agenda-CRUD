<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: #f5f5f5;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.AgregarController">

    <children>
        <Label fx:id="lblTitulo" text="Registrar Nueva Persona"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" />

        <Separator style="-fx-background-color: #ddd;" />

        <VBox spacing="5">
            <Label text="Datos Personales" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
            <Label text="Nombre completo:" style="-fx-font-size: 12px; -fx-text-fill: #666;" />
            <TextField fx:id="txtNombre" style="-fx-font-size: 13px;" promptText="Ej. Juan Pérez" />
        </VBox>

        <Separator style="-fx-background-color: #ddd;" />

        <VBox spacing="10">
            <Label text="Direcciones" style="-fx-font-weight: bold; -fx-font-size: 14px;" />

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtNuevaDireccion"
                           promptText="Escribe la dirección (Calle, #, Col)"
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 13px;" />
                <Button text="Agregar"
                        onAction="#agregarDireccionALista"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;" />
            </HBox>

            <ListView fx:id="listDirecciones"
                      prefHeight="100.0"
                      style="-fx-border-color: #ddd; -fx-border-radius: 5;" />

            <Button fx:id="btnEliminarDireccion"
                    text="Eliminar dirección seleccionada"
                    onAction="#eliminarDireccionSeleccionada"
                    style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-cursor: hand;"
                    disable="true"/>
        </VBox>

        <Separator style="-fx-background-color: #ddd;" />

        <VBox spacing="10">
            <Label text="Números Telefónicos" style="-fx-font-weight: bold; -fx-font-size: 14px;" />

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtNuevoTelefono"
                           promptText="Escribe el número"
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 13px;" />
                <Button text="Agregar"
                        onAction="#agregarTelefonoALista"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;" />
            </HBox>

            <ListView fx:id="listTelefonos"
                      prefHeight="100.0"
                      style="-fx-border-color: #ddd; -fx-border-radius: 5;" />

            <Button fx:id="btnEliminarTelefono"
                    text="Eliminar teléfono seleccionado"
                    onAction="#eliminarTelefonoSeleccionado"
                    style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-cursor: hand;"
                    disable="true"/>
        </VBox>

        <Separator style="-fx-background-color: #ddd;" />

        <HBox spacing="15" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" />
            </padding>
            <Button text="Cancelar" onAction="#cerrarVentana"
                    style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand;" />
            <Button text="Guardar Todo" onAction="#guardarPersona"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-cursor: hand;" />
        </HBox>
    </children>
</VBox>